# Copy this file to .env and fill in your own values.
# .env is the SINGLE place to change database credentials and other secrets.

# --- Database (PostgreSQL) ---
# Change these to match your local PostgreSQL setup:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ebsmi_screening
DB_USER=postgres
DB_PASS=your_postgres_password_here

# --- Email (Brevo) ---
BREVO_API_KEY=your_brevo_api_key_here

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

# --- Field-level encryption (sensitive data at rest) ---
# At least 32 random characters. Generate: php -r "echo bin2hex(random_bytes(32));"
ENCRYPTION_KEY=your_32_char_encryption_key_here

